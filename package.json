{
  "name": "mandao-pipeline-pruebas",
  "version": "1.0.0",
  "description": "Pipeline de CI/CD con pruebas unitarias y end-to-end para la app de demostración Mandao",
  "private": true,
  "scripts": {
    "servir": "python3 -m http.server 4173 --directory app",
    "test:unit": "mkdir -p reportes && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reportes/unitarias.xml 'tests/unitarias/**/*.test.js'",
    "test:e2e": "playwright test",
    "resumen": "node scripts/resumen.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
